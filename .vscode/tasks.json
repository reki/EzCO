{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "EzCo: ビルド",
            "type": "shell",
            "command": "poetry",
            "args": [
                "run",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "EzCo: ビルド (--safe-mode)",
            "type": "shell",
            "command": "poetry",
            "args": [
                "run",
                "build",
                "--",
                "--safe-mode"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "EzCo: 頒布用zip (collect)",
            "type": "shell",
            "command": "poetry",
            "args": [
                "run",
                "collect"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "EzCo: インストーラ (installer)",
            "type": "shell",
            "command": "poetry",
            "args": [
                "run",
                "installer"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "EzCo: 初期化",
            "type": "shell",
            "command": "poetry",
            "args": [
                "run",
                "init-env"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "EzCo: テスト",
            "type": "shell",
            "command": "poetry",
            "args": [
                "run",
                "pytest"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}
