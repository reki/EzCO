{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: EzCo",
            "type": "debugpy",
            "request": "launch",
            "module": "ez_co.main",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python: EzCo(Archive:False)",
            "type": "debugpy",
            "request": "launch",
            "module": "ez_co.main",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "args": [
                "--conf:archive.enabled=False"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python: EzCo(Profile:Test)",
            "type": "debugpy",
            "request": "launch",
            "module": "ez_co.main",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "args": [
                "--profile=テスト"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python: EzCo(Profile:Test and Archive:False)",
            "type": "debugpy",
            "request": "launch",
            "module": "ez_co.main",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "args": [
                "--profile=テスト",
                "--conf:archive.enabled=False"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "▶ ビルド (poetry run build)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "EzCo: ビルド"
        },
        {
            "name": "▶ ビルド (--safe-mode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "EzCo: ビルド (--safe-mode)"
        },
        {
            "name": "▶ 頒布用zip (poetry run collect)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "EzCo: 頒布用zip (collect)"
        },
        {
            "name": "▶ インストーラ (poetry run installer)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "EzCo: インストーラ (installer)"
        },
        {
            "name": "▶ 初期化 (poetry run init-env)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "EzCo: 初期化"
        },
        {
            "name": "▶ プラグインZIP (poetry run pack-plugins)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "EzCo: プラグインZIP"
        },
        {
            "name": "▶ langs チェック (poetry run langs check)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "EzCo: langs チェック"
        },
        {
            "name": "▶ テスト (poetry run pytest)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "EzCo: テスト"
        },
        {
            "name": "▶ 計測: 画像読み込み smoke (1分未満)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "計測: 画像読み込み smoke (1分未満)"
        },
        {
            "name": "▶ 計測: worker 1〜8 基準 (数分)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "計測: worker 1〜8 基準 (数分)"
        },
        {
            "name": "▶ 計測: worker × cache matrix (数分)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "計測: worker × cache matrix (数分)"
        },
        {
            "name": "▶ 計測: 推奨設定 policy matrix (数分)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "計測: 推奨設定 policy matrix (数分)"
        },
        {
            "name": "▶ 計測: 性能一括 (十数分)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "計測: 性能一括 (十数分)"
        },
        {
            "name": "▶ 計測: 表示準備コスト (1〜2分)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/noop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "preLaunchTask": "計測: 表示準備コスト (1〜2分)"
        },
        {
            "name": "Python: 実測ダイアログ smoke (デバッグ可)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tooling/image_loading_benchmark_dialog_smoke.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "py-spy: top (EzCo)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/pyspy.ps1\" -Mode top",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "py-spy: record SVG (EzCo)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/pyspy.ps1\" -Mode record-svg",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "py-spy: record speedscope (EzCo)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/pyspy.ps1\" -Mode record-speedscope",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}
